{
  "languages": {
    "scala": {
      "lspCommand": ["metals"],
      "runnerCommand": ["scala-cli", "run", "--server=false", "-q"],
      "sentinelTemplate": "println(\"%s\")",
      "fileExtension": ".sc"
    },
    "python": {
      "lspCommand": ["pyright-langserver", "--stdio"],
      "runnerCommand": ["python3", "-u"],
      "sentinelTemplate": "print(\"%s\", flush=True)",
      "fileExtension": ".py"
    },
    "r": {
      "lspCommand": ["R", "--slave", "-e", "languageserver::run()"],
      "runnerCommand": ["Rscript"],
      "sentinelTemplate": "cat(\"%s\\n\")",
      "fileExtension": ".R"
    },
    "bash": {
      "lspCommand": ["bash-language-server", "start"],
      "runnerCommand": ["bash"],
      "sentinelTemplate": "echo \"%s\"",
      "fileExtension": ".sh"
    },
    "clojure": {
      "lspCommand": ["clojure-lsp"],
      "runnerCommand": ["clojure", "-M"],
      "sentinelTemplate": "(do (println \"%s\") (flush))",
      "fileExtension": ".clj"
    },
    "lisp": {
      "lspCommand": ["cl-lsp"],
      "runnerCommand": ["sbcl", "--noinform", "--script"],
      "sentinelTemplate": "(progn (format t \"~a~%%\" \"%s\") (finish-output))",
      "fileExtension": ".lisp"
    },
    "node": {
      "lspCommand": ["typescript-language-server", "--stdio"],
      "runnerCommand": ["node"],
      "sentinelTemplate": "console.log(\"%s\")",
      "fileExtension": ".js"
    },
    "idris": {
      "lspCommand": ["idris2-lsp"],
      "runnerCommand": ["idris2", "--source-dir", "/", "--exec", "main"],
      "sentinelTemplate": "putStrLn \"%s\"",
      "fileExtension": ".idr",
      "replayPreviousCells": false
    }
  }
}
